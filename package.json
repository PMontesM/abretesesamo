{
  "name": "abretesesamo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node frontend/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/unified-ui.mjs && node tests/alpine-ui.mjs && node tests/accounts-ui.mjs && node tests/navigation-ui.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "node tools/release.mjs",
    "db:check": "node tools/verificar-bd.mjs",
    "setup:frontend": "npm ci --prefix frontend --ignore-scripts",
    "release": "node tools/release.mjs",
    "backup": "node tools/backup.mjs",
    "backup:verify": "node tools/restore-check.mjs",
    "db:migrate": "node tools/migrate.mjs",
    "format": "prettier --write src frontend/src frontend/templates tests tools",
    "format:check": "prettier --check src frontend/src frontend/templates tests tools"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "hono": "^4.13.10"
  }
}
