{
  "name": "abretesesamo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node frontend/build.mjs && node tools/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/unified-ui.mjs && node tests/alpine-ui.mjs && node tests/accounts-ui.mjs && node tests/navigation-ui.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:check": "node tools/verificar-bd.mjs",
    "setup:frontend": "npm ci --prefix frontend --ignore-scripts"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.130.0"
  },
  "dependencies": {
    "hono": "^4.13.10"
  }
}
